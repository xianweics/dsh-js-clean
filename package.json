{
  "name": "dsh-js-clean",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: score JavaScript cleanliness and name the refactoring (Extract Function, Guard Clauses, …) for every code smell found.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./analyzer": "./lib/analyzer.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "scripts": {
    "test": "node test/analyzer.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "javascript",
    "refactoring",
    "code-smell",
    "clean-code",
    "code-quality",
    "static-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianweics/dsh-js-clean.git"
  },
  "homepage": "https://github.com/xianweics/dsh-js-clean#readme",
  "bugs": {
    "url": "https://github.com/xianweics/dsh-js-clean/issues"
  },
  "author": "dsh-js-clean contributors",
  "license": "MIT"
}
